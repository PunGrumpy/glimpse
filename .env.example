# "web" (default) reads Instagram's API; "mock" serves fake data for UI work.
IG_PROVIDER=web

# Optional service account: the `sessionid` cookie of an Instagram account you
# control. Lets every visitor watch stories and highlights without entering
# anything. Only used for data any logged-in account can see; never used to
# show private accounts. Use a throwaway account: automated use is against
# Instagram's terms and the account can be restricted.
IG_SESSION_ID=

# Private accounts are unlocked per visitor instead: each visitor can paste
# their own sessionid at /accounts/session (kept in an httpOnly cookie in their
# browser, never cached or shared with other visitors).
